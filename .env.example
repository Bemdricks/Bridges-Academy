VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Staff dashboard (/admin):
# 1. Run supabase/migrations/20261027121700_admin_dashboard.sql in the Supabase SQL editor.
# 2. Create a user in Authentication and turn off public sign-ups.
# 3. insert into public.admin_users (user_id)
#    select id from auth.users where email = 'staff@example.com';

# Email when a dashboard submission arrives (set these in Netlify, not in the browser):
#   SUPABASE_SERVICE_ROLE_KEY   the service_role key from Supabase → Project Settings → API
#   RESEND_API_KEY              from resend.com, after verifying carmelacademy.school
#   NOTIFY_EMAIL                info@carmelacademy.school (comma-separate more than one)
#   NOTIFY_FROM                 Carmel Academy <info@carmelacademy.school>
# Then run supabase/migrations/20261110140000_submission_notifications.sql in the SQL editor.
